{
  "name": "@deckatron/deck-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Local A2A deck-creation placeholder",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist\\tests\\placeholder.test.js",
    "start": "node --env-file-if-exists=..\\..\\.env dist\\server.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.14",
    "typescript": "^5.9.3"
  }
}
