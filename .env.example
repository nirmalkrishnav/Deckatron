DECK_ROUTER_HOST=127.0.0.1
DECK_ROUTER_PORT=8000
DECK_ROUTER_PUBLIC_URL=http://localhost:8000

# Existing A2A service base URLs; each must expose /.well-known/agent-card.json.
# Example: http://localhost:8001 (creation), http://localhost:8002 (editing).
# For the local echo mock, set BOTH URLs to http://127.0.0.1:8001.
DECK_ROUTER_CREATOR_URL=
DECK_ROUTER_EDITOR_URL=
DECK_ROUTER_REQUEST_TIMEOUT=120
DECK_ROUTER_SELECTOR=decision

# Decision-family models; use the Azure provider base URL from your deployment.
# Example: https://YOUR-RESOURCE.services.ai.azure.com/providers/microsoft
AZURE_DECISION_ENDPOINT=
DECISION_API_KEY=
DECISION_MODEL=Decision-1
DECISION_TIMEOUT=60

# Optional GPT-style LLM utility / routing (DECK_ROUTER_SELECTOR=llm).
# Set deployment to your available deployment name, for example gpt-6-luna.
# LLM routing requires structured outputs (JSON schema).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT=60
